{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET без ключа отдаёт список таблиц (защита отключена)",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET несуществующей таблицы возвращает 404",
      "method": "GET",
      "path": "/?entity=no_such_table_xyz",
      "expectedStatus": 404
    }
  ]
}
